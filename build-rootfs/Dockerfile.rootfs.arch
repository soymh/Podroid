# build-rootfs/Dockerfile.rootfs.arch — Arch Linux rootfs (aarch64) for Podroid.
#
# Mirrors Dockerfile.rootfs, but bootstraps ArchLinuxARM (aarch64 tarball)
# instead of Alpine minirootfs + apk. Init stays OpenRC (same podroid-* services,
# same inittab/rc.conf, same runlevel-symlink approach — no chroot
# rc-update since the builder host is x86_64).
#
# dm-crypt userspace (cryptsetup, lvm2, device-mapper/dmsetup) is installed
# here; the kernel already ships CONFIG_DM_CRYPT=y, CONFIG_CRYPTO_AES=y,
# CONFIG_CRYPTO_XTS=y, CONFIG_CRYPTO_ARGON2=y, CONFIG_CRYPTO_SHA256=y,
# so stock LUKS2 works out of the box.
#
# OpenRC comes from the AUR (not in Arch official repos); everything else
# installs from the official ArchLinuxARM repos with plain pacman.

# ── Stage 1: cross-compile podroid helpers (musl-static aarch64) ──────────
# Identical to Dockerfile.rootfs — reused unchanged so the guest<->Android
# bridge (podroid-hostd multi-call: notify/forward/open/power/headless/server),
# the vsock agent, and the overlay normalizer behave the same on both distros.
FROM --platform=linux/arm64 alpine:3.24 AS vsock-builder
RUN apk add --no-cache musl-dev gcc make linux-headers
WORKDIR /work
COPY vsock-agent /work/vsock-agent
RUN cd /work/vsock-agent && make CC=gcc
COPY host-bridge /work/host-bridge
RUN cd /work/host-bridge && make CC=gcc
COPY overlay-normalize /work/overlay-normalize
RUN cd /work/overlay-normalize && make CC=gcc

# ── Stage 2: bootstrap + customize the Arch rootfs ────────────────────────
# NOTE: the official archlinux image is amd64-only (no arm64 manifest), so it
# can never resolve with --platform=linux/arm64. Instead we bootstrap from the
# official ArchLinuxARM aarch64 tarball, promoted to a real container stage so
# docker provides /dev + /proc (chroot-in-build cannot: no Landlock for
# pacman's sandbox, no mtab without proc, no /dev/fd for makepkg's process
# substitution — three separate failures before this shape).
# Init is stock systemd + systemd-sysvcompat: no AUR stack was ever needed
# for it, and the AUR openrc builds are gone for good (they cost ~5 min and
# ~500MB for an init that never ran as PID 1). All podroid-* bring-up lives
# in files-arch/etc/systemd/system. Do NOT re-add AUR packages.
# NOTE: ArchLinuxARM ships neither elogind (it uses systemd-logind, which has
# no OpenRC support and isn't needed headless) nor bridge-utils (deprecated;
# iproute2 covers bridge setup) — do not re-add them.
FROM --platform=linux/arm64 alpine:3.24 AS alarm-fetch

RUN apk add --no-cache curl tar

WORKDIR /alarm

# Fetch + unpack the ArchLinuxARM aarch64 minimal rootfs.
RUN curl -L --retry 3 -o alarm.tar.gz \
        http://os.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz \
    && mkdir -p root \
    && tar -xzpf alarm.tar.gz -C root \
    && rm alarm.tar.gz

# ── Stage 3: customize the Arch rootfs (real container, no chroot) ─────────
FROM scratch AS arch-builder
COPY --from=alarm-fetch /alarm/root/. /

ARG SYSTEM_VERSION=0
ENV SYSTEM_VERSION=${SYSTEM_VERSION}

WORKDIR /work

# Pacman 7 sandboxes downloads via Landlock + an unprivileged `alpm` user;
# build containers lack Landlock, so DB sync fails without DisableSandbox
# (the documented container escape hatch; guest runtime is unaffected).
RUN sed -i '/^#*DisableSandbox/d; /^\[options\]/a DisableSandbox' /etc/pacman.conf \
    && grep -q '^DisableSandbox' /etc/pacman.conf

# Keyring + full upgrade. Fail-fast throughout: any error aborts the build
# (CI goes red) instead of shipping a broken squashfs.
RUN pacman-key --init \
    && pacman-key --populate archlinuxarm \
    && pacman -Syu --noconfirm

# Guest runtime packages. systemd + systemd-sysvcompat provide PID 1
# (/sbin/init symlink); sudo stays (wheel users, like Alpine); dhcpcd backs
# the AVF DHCP fallback in podroid-network; git stays as a user tool.
# (base-devel was only ever needed for the removed AUR builds.)
RUN pacman -S --noconfirm --needed \
        base \
        filesystem \
        bash \
        busybox \
        shadow \
        sudo \
        systemd \
        systemd-sysvcompat \
        podman \
        crun \
        fuse-overlayfs \
        slirp4netns \
        netavark \
        aardvark-dns \
        docker \
        docker-compose \
        lxc \
        dnsmasq \
        openssh \
        iptables \
        nftables \
        iproute2 \
        curl \
        ca-certificates \
        tigervnc \
        pulseaudio \
        cryptsetup \
        lvm2 \
        device-mapper \
        libcap \
        squashfs-tools \
        gzip \
        xz \
        ttf-dejavu \
        git

# Drop build-time weight: package cache, sync DBs (re-fetchable in the guest
# via `pacman -Sy`; the local DB stays since pacman -Q/-R need it), temp dirs.
# linux-aarch64 is the distro kernel, not ours — remove only if present.
RUN pacman -Scc --noconfirm \
    && rm -rf /var/lib/pacman/sync/* /tmp/aur \
    && if pacman -Qq linux-aarch64 >/dev/null 2>&1; then \
           pacman -Rns --noconfirm linux-aarch64; \
       fi

# Hard assertion: PID 1 must resolve to systemd (init-podroid switch_roots
# into /sbin/init, which systemd-sysvcompat links there).
RUN test -x /usr/lib/systemd/systemd && test -e /sbin/init || { echo "ERROR: systemd init missing from rootfs"; exit 1; }

# Pull in the vsock-agent / host-bridge binaries built in stage 1.
COPY --from=vsock-builder /work/vsock-agent/podroid-vsock-agent /usr/local/bin/podroid-vsock-agent
COPY --from=vsock-builder /work/host-bridge/podroid-hostd /usr/local/bin/podroid-hostd
COPY --from=vsock-builder /work/overlay-normalize/podroid-overlay-normalize /usr/local/bin/podroid-overlay-normalize

COPY files /work/files
COPY files-arch /work/files-arch
COPY build-rootfs-arch.sh /work/build-rootfs-arch.sh

# Relocate the tree under /work/rootfs for customization + packing. tar copy
# (not mv — the stage root is live): excludes are build-only paths + runtime
# pseudo-mounts (recreated empty below). /etc/mtab is docker's symlink —
# excluded and recreated as a /proc/self/mounts symlink (standard; live
# guest has /proc). Relocation happens BEFORE build-rootfs-arch.sh because
# the script writes /etc/resolv.conf + hostname + hosts, which are read-only
# docker bind mounts at the stage root but regular files under /work/rootfs.
RUN mkdir -p /work/rootfs \
    && tar -C / --exclude=./work --exclude=./proc --exclude=./sys --exclude=./dev --exclude=./tmp --exclude=./run --exclude=./etc/mtab --exclude=./.dockerenv --exclude=./etc/resolv.conf --exclude=./etc/hostname --exclude=./etc/hosts -cf - . \
        | tar -xpf - -C /work/rootfs \
    && mkdir -p /work/rootfs/dev /work/rootfs/proc /work/rootfs/sys /work/rootfs/tmp /work/rootfs/run \
    && chmod 1777 /work/rootfs/tmp \
    && ln -sf /proc/self/mounts /work/rootfs/etc/mtab

RUN chmod +x /work/build-rootfs-arch.sh && /work/build-rootfs-arch.sh

RUN mksquashfs /work/rootfs /work/arch-rootfs.squashfs \
    -comp zstd -Xcompression-level 19 -all-root -noappend
# (No -no-xattrs: rootless podman's newuidmap/newgidmap need their
# file capabilities preserved; they're stored as security.capability xattr.)

# Size audit (visible in CI log): totals + top space hogs guide trimming rounds.
RUN ls -lh /work/arch-rootfs.squashfs \
    && du -sh /work/rootfs \
    && du -x -d2 /work/rootfs 2>/dev/null | sort -rh | head -30

FROM scratch AS export
COPY --from=arch-builder /work/arch-rootfs.squashfs /arch-rootfs.squashfs
